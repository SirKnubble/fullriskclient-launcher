pkgname=fullrisk-launcher
pkgver=0.6.29
pkgrel=1
pkgdesc="FullRiskClient Launcher"
arch=('x86_64')
url="https://github.com/SirKnubble/fullriskclient-launcher"
license=('MIT')
depends=('webkit2gtk-4.1' 'libayatana-appindicator' 'librsvg')
makedepends=('git' 'nodejs' 'yarn' 'rust' 'dpkg' 'patchelf')
_tagver="${pkgver//_/-}"
source=("fullriskclient-launcher::git+https://github.com/SirKnubble/fullriskclient-launcher.git#tag=v${_tagver}")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/fullriskclient-launcher"
  yarn install --frozen-lockfile
  yarn tauri build --release --bundles deb
}

package() {
  cd "${srcdir}/fullriskclient-launcher"
  local deb
  deb="$(find src-tauri/target/release/bundle/deb -maxdepth 1 -name '*.deb' -print -quit)"
  [[ -n "${deb}" ]] || error "Tauri did not produce a Debian package"
  dpkg-deb -x "${deb}" "${pkgdir}"
}
